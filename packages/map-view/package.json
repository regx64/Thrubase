{
  "name": "@thrubase/map-view",
  "version": "0.1.0",
  "private": true,
  "description": "Thrubase shared UI: terrain map, trail list, segment and checkpoint cards.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs && node scripts/copy-fonts.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc --noEmit && vite build && node scripts/copy-output.mjs",
    "typecheck": "npm run tokens && tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "d3-contour": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fontsource-variable/jetbrains-mono": "5.2.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-contour": "3.0.6",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "4.4.1",
    "@vscode/codicons": "0.0.36",
    "jsdom": "26.1.0",
    "pretendard": "1.3.9",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
