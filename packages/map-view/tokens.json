{
  "$description": "Thrubase design system tokens. tokens.css is generated from this file (npm run tokens).",
  "color": {
    "surface":        { "light": "#ffffff", "dark": "#1e1e1e", "vscode": "var(--vscode-editor-background)" },
    "surface-sunken": { "light": "#f5f5f7", "dark": "#181818", "vscode": "var(--vscode-sideBar-background, var(--vscode-editor-background))" },
    "surface-raised": { "light": "#ffffff", "dark": "#252526", "vscode": "var(--vscode-editorWidget-background)" },
    "line":           { "light": "#e3e3e8", "dark": "#3a3a3d", "vscode": "var(--vscode-panel-border, var(--vscode-widget-border, transparent))" },
    "line-strong":    { "light": "#8b8b96", "dark": "#7d7d86", "vscode": "var(--vscode-input-border, var(--vscode-contrastBorder, #8b8b96))" },
    "ink":            { "light": "#1d1d22", "dark": "#e6e6e8", "vscode": "var(--vscode-foreground)" },
    "ink-muted":      { "light": "#5c5c68", "dark": "#a6a6ae", "vscode": "var(--vscode-descriptionForeground)" },
    "accent":         { "light": "#1e3a8a", "dark": "#93a8f4" },
    "accent-ink":     { "light": "#1e3a8a", "dark": "#a9bbf7" },
    "accent-soft":    { "light": "#e8edfa", "dark": "#1c2440" },
    "on-accent":      { "light": "#ffffff", "dark": "#0b1433" },
    "pass":           { "light": "#1e7a3c", "dark": "#5cc77c", "vscode": "var(--vscode-charts-green)" },
    "pass-soft":      { "light": "#e6f4ea", "dark": "#18301f", "vscode": "color-mix(in srgb, var(--vscode-charts-green) 15%, transparent)" },
    "weak":           { "light": "#8a5b00", "dark": "#e5bd4a", "vscode": "var(--vscode-charts-yellow)" },
    "weak-soft":      { "light": "#fdf3dc", "dark": "#3a2f12", "vscode": "color-mix(in srgb, var(--vscode-charts-yellow) 15%, transparent)" },
    "danger":         { "light": "#b3263e", "dark": "#f2707f", "vscode": "var(--vscode-errorForeground)" },
    "statusbar":      { "light": "#007acc", "dark": "#181818" },
    "on-statusbar":   { "light": "#ffffff", "dark": "#cccccc" }
  },
  "contour": {
    "base": "ink",
    "steps": [7, 11, 16, 22, 30, 40]
  },
  "font": {
    "sans": { "value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Pretendard, \"Apple SD Gothic Neo\", \"Noto Sans KR\", sans-serif", "vscode": "var(--vscode-font-family)" },
    "mono": { "value": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace", "vscode": "var(--vscode-editor-font-family)" },
    "icon": { "value": "codicon" }
  },
  "type": {
    "title":      { "family": "sans", "size": 20, "line": 28, "weight": 600 },
    "heading":    { "family": "sans", "size": 15, "line": 22, "weight": 600 },
    "question":   { "family": "sans", "size": 15, "line": 24, "weight": 400 },
    "body":       { "family": "sans", "size": 13, "line": 20, "weight": 400 },
    "label":      { "family": "sans", "size": 12, "line": 16, "weight": 600 },
    "caption":    { "family": "sans", "size": 11, "line": 16, "weight": 400 },
    "code":       { "family": "mono", "size": 13, "line": 20, "weight": 400 },
    "code-small": { "family": "mono", "size": 11, "line": 16, "weight": 400 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "size": { "row-sidebar": 22, "control-sm": 26, "control-md": 32, "icon": 16, "icon-lg": 24 },
  "radius": { "sm": 4, "control": 6, "card": 10 },
  "motion": {
    "duration-fast": "150ms",
    "duration-base": "200ms",
    "duration-slow": "250ms",
    "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
    "opacity-unsure": 0.4
  }
}
